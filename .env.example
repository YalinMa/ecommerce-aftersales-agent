# 复制为 .env 后填写。只需要填你要用的厂商。

# 默认厂商：anthropic / openai / deepseek / minimax / qwen / kimi / glm
AGENT_PROVIDER=deepseek

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
DASHSCOPE_API_KEY=      # 通义千问（阿里云百炼）
MOONSHOT_API_KEY=       # Kimi
ZHIPU_API_KEY=          # 智谱 GLM

# 可选：覆盖模型名（运行 scripts/list_models.py 查看可用模型）
# DEEPSEEK_MODEL=deepseek-v4-pro
# QWEN_MODEL=qwen-max

# 可选：海外账号切换接入点
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# GLM_BASE_URL=https://api.z.ai/api/paas/v4

# 可选：仅 Anthropic 生效
# AGENT_EFFORT=low
# AGENT_USE_FALLBACK=1

# 商城 MCP 服务（V4）。客服 Agent 连接的地址；本机地址未运行时会自动启动
# MALL_MCP_URL=http://127.0.0.1:8765/mcp
# 身份令牌、确认签名的密钥：商城和客服 Agent 两边必须一致。演示环境有默认值，生产环境务必改成随机长字符串
# MALL_AUTH_SECRET=
# MALL_CONFIRM_SECRET=
